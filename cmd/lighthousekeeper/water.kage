//kage:unit pixels
package main

// Clock is presentation time only. Simulated boat/beam positions come from the
// deterministic Go rules, never from this shader.
var Clock float

// A faithful painterly sea via the old scanline-scroll principle. All samples
// come from the CLEAN water plate; the static rocks are separate overlays.
func Fragment(dstPos vec4, srcPos vec2, color vec4) vec4 {
    fixed := imageSrc0At(srcPos)
    inside := imageSrc1AtFromSrc0Pos(srcPos).r
    if inside < 0.004 {
        return fixed
    }
    depth := clamp((srcPos.y-570.0)/840.0, 0.0, 1.0)
    depth = depth * depth * (3.0 - 2.0 * depth)
    a := sin(srcPos.y*0.055-Clock*1.8+srcPos.x*0.0075)
    b := sin(srcPos.y*0.023+srcPos.x*0.009-Clock*0.72)
    c := sin(srcPos.x*0.048+srcPos.y*0.012+Clock*1.4)
    factor := (0.32+depth*1.28)*inside
    offset := vec2((6.4*a+4.2*b+2.6*c)*factor, (2.2*a+3.0*b)*factor)
    source := clamp(srcPos+offset, vec2(2.0), vec2(1917.0, 1437.0))
    moving := imageSrc0At(source)
    return mix(fixed,moving,inside)
}
